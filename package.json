{
  "name": "@meri-imperiumi/signalk-triplogger",
  "version": "1.4.1",
  "description": "Log the length of the current trip",
  "main": "index.js",
  "scripts": {
    "test": "node --test --test-force-exit \"tests/*.test.js\" && eslint .",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/meri-imperiumi/signalk-triplogger.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility"
  ],
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "appIcon": "./doc/appicon-256.png",
    "displayName": "Automatic Trip Length Logger",
    "requires": [
      "@meri-imperiumi/signalk-autostate"
    ]
  },
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/meri-imperiumi/signalk-triplogger/issues"
  },
  "homepage": "https://github.com/meri-imperiumi/signalk-triplogger#readme",
  "dependencies": {
    "where": "^0.4.3"
  },
  "devDependencies": {
    "eslint": "^8.14.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.18.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
